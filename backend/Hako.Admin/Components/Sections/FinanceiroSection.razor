<div class="toolbar">
    <div class="actions">
        <button class="btn primary" @onclick="Novo">+ Novo lançamento</button>
    </div>
    <div class="pager">
        <button disabled title="Início">⏮</button><button disabled title="Anterior">◀</button>
        <span>1 / 1</span>
        <button disabled title="Próximo">▶</button><button disabled title="Fim">⏭</button>
    </div>
</div>

<div class="grid-card">
    <table class="grid">
        <thead><tr><th></th><th>Status</th><th>Descrição</th><th class="hide-m">Referente a</th><th class="hide-m">Vencimento</th><th class="num">Valor</th></tr></thead>
        <tbody>
            @foreach (var l in Rows)
            {
                <tr @onclick="() => Editar(l)">
                    <td><span class="dir @(l.Pagar ? "out" : "in")" title="@(l.Pagar ? "A pagar" : "A receber")">@(l.Pagar ? "▲" : "▼")</span></td>
                    <td><span class="badge @l.StatusCls">@l.Status</span></td>
                    <td>@l.Desc</td>
                    <td class="hide-m">@l.Ref</td>
                    <td class="mono hide-m">@l.Venc</td>
                    <td class="num mono">@l.Valor</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Form is not null)
{
    <div class="modal-back" @onclick="Fechar">
        <div class="modal" @onclick:stopPropagation>
            <h3>@(IsNew ? "Novo lançamento" : "Lançamento")</h3>
            <label class="fld">Tipo
                <select @bind="Form.Pagar"><option value="false">A receber ▼</option><option value="true">A pagar ▲</option></select>
            </label>
            <label class="fld">Descrição<input @bind="Form.Desc"></label>
            <label class="fld">Referente a<input @bind="Form.Ref" placeholder="Cliente, parceiro ou fornecedor"></label>
            <div class="fld-row">
                <label class="fld">Vencimento<input @bind="Form.Venc" placeholder="dd/mm/aaaa"></label>
                <label class="fld">Valor<input @bind="Form.Valor" placeholder="R$ 0,00"></label>
            </div>
            @if (!IsNew)
            {
                <label class="fld">Status
                    <select @bind="Form.Status"><option>Pendente</option><option>Pago</option><option>Vencido</option></select>
                </label>
            }
            @if (Cancelando)
            {
                <label class="fld">Justificativa do cancelamento (obrigatória)
                    <textarea rows="2" placeholder="Motivo do cancelamento deste lançamento"></textarea>
                </label>
            }
            <div class="actions end">
                <button class="btn" @onclick="Fechar">Voltar</button>
                @if (!IsNew && !Cancelando) { <button class="btn danger" @onclick="() => Cancelando = true">Cancelar lançamento</button> }
                @if (Cancelando) { <button class="btn danger" @onclick="Fechar">Confirmar cancelamento</button> }
                <button class="btn primary" @onclick="Salvar">Salvar</button>
            </div>
        </div>
    </div>
}

@code {
    class Lanc
    {
        public int Id; public bool Pagar; public string Status = "Pendente"; public string StatusCls = "b-warn";
        public string Desc = ""; public string Ref = ""; public string Venc = ""; public string Valor = "";
    }

    List<Lanc> Rows =
    [
        new() { Id = 1, Status = "Pago", StatusCls = "b-ok", Desc = "Parcela 1/3 — Cozinha apto 402", Ref = "Mariana Costa", Venc = "05/10/2026", Valor = "R$ 18.500" },
        new() { Id = 2, Status = "Pendente", StatusCls = "b-warn", Desc = "Parcela 2/3 — Cozinha apto 402", Ref = "Mariana Costa", Venc = "05/11/2026", Valor = "R$ 18.500" },
        new() { Id = 3, Status = "Vencido", StatusCls = "b-err", Desc = "Entrada — Painel living", Ref = "Mariana Costa", Venc = "20/10/2026", Valor = "R$ 6.200" },
        new() { Id = 4, Status = "Pendente", StatusCls = "b-warn", Desc = "Sinal — Dormitório planejado", Ref = "Roberto Almeida", Venc = "02/11/2026", Valor = "R$ 9.800" },
        new() { Id = 5, Pagar = true, Status = "Pendente", StatusCls = "b-warn", Desc = "Comissão projeto apto 402", Ref = "Arq. Sofia Ribeiro", Venc = "10/11/2026", Valor = "R$ 4.440" },
        new() { Id = 6, Pagar = true, Status = "Vencido", StatusCls = "b-err", Desc = "Mão de obra montagem", Ref = "Marcos Eletricista", Venc = "25/10/2026", Valor = "R$ 2.300" },
        new() { Id = 7, Pagar = true, Status = "Pago", StatusCls = "b-ok", Desc = "Pedra mármore — banheiro", Ref = "Marmoraria Itália", Venc = "12/10/2026", Valor = "R$ 7.850" },
        new() { Id = 8, Pagar = true, Status = "Pendente", StatusCls = "b-warn", Desc = "MDF + ferragens lote 12", Ref = "Fornecedor Duratex", Venc = "30/10/2026", Valor = "R$ 11.200" },
    ];

    Lanc? Form;
    bool IsNew;
    bool Cancelando;

    void Novo() { Form = new Lanc(); IsNew = true; Cancelando = false; }
    void Editar(Lanc l) { Form = l; IsNew = false; Cancelando = false; }
    void Fechar() { Form = null; Cancelando = false; }
    void Salvar() { if (IsNew) { Form!.Id = Rows.Count + 1; Rows.Insert(0, Form!); } Fechar(); }
}
