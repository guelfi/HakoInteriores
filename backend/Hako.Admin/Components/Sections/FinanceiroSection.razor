@inject MockErpStore Store

<p class="hint">
    Visão consolidada (Uma fonte, três recortes: Geral · Aba Financeiro do Serviço · Aba7 Financeiro do Cliente) — valores em reais, baixa rápida e cancelamento auditável sem exclusão.
</p>

<!-- Top KPI Strip -->
<div class="widgets" style="grid-template-columns:repeat(auto-fit,minmax(185px,1fr));flex:none;margin-bottom:16px">
    <div class="widget">
        <span class="w-label">Total a Receber (Ativos)</span>
        <strong class="up">@MockErpStore.FormatMoeda(TotalReceberAtivos)</strong>
        <small>Recebido: @MockErpStore.FormatMoeda(TotalRecebidoPago) · Aberto: @MockErpStore.FormatMoeda(TotalReceberAberto)</small>
    </div>
    <div class="widget">
        <span class="w-label">Total a Pagar (Ativos)</span>
        <strong class="down">@MockErpStore.FormatMoeda(TotalPagarAtivos)</strong>
        <small>Pago: @MockErpStore.FormatMoeda(TotalPagoEfetivo) · Aberto: @MockErpStore.FormatMoeda(TotalPagarAberto)</small>
    </div>
    <div class="widget">
        <span class="w-label">Saldo Previsto</span>
        <strong class='@(SaldoPrevisto >= 0 ? "up" : "down")'>@MockErpStore.FormatMoeda(SaldoPrevisto)</strong>
        <small>Saldo realizado em caixa: <b>@MockErpStore.FormatMoeda(SaldoRealizado)</b></small>
    </div>
    <div class='widget @(QtdVencidos > 0 ? "danger" : "")'>
        <span class="w-label">Vencidos 🔴</span>
        <strong class="down">@MockErpStore.FormatMoeda(TotalVencidos)</strong>
        <small>@QtdVencidos lançamento(s) em atraso</small>
    </div>
    <div class='widget @(TotalComissoesPendentes > 0 ? "warn" : "")'>
        <span class="w-label">Comissões Pendentes</span>
        <strong>@MockErpStore.FormatMoeda(TotalComissoesPendentes)</strong>
        <small>@QtdComissoesPendentes comissão(ões) de parceiros</small>
    </div>
</div>

<!-- Toolbar -->
<div class="toolbar">
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;flex:1">
        @if (Store.HasPerm("financeiro.edit"))
        {
            <button class="btn primary" @onclick="AbrirNovo">+ Novo lançamento</button>
        }
        <input type="search"
               placeholder="Buscar descrição, cliente ou beneficiário..."
               value="@Busca"
               @oninput="OnBuscaChanged"
               style="background:var(--card);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:7px 11px;font-size:13px;min-width:220px;flex:1;max-width:300px" />

        <select value="@FiltroDirecao" @onchange='e => { FiltroDirecao = e.Value?.ToString() ?? "todos"; Page = 1; }'
                style="background:var(--card);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:7px 10px;font-size:13px">
            <option value="todos">Direção: Todos</option>
            <option value="receber">▼ A Receber</option>
            <option value="pagar">▲ A Pagar</option>
        </select>

        <select value="@FiltroStatus" @onchange='e => { FiltroStatus = e.Value?.ToString() ?? "todos"; Page = 1; }'
                style="background:var(--card);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:7px 10px;font-size:13px">
            <option value="todos">Status: Todos</option>
            <option value="pendente">Pendente</option>
            <option value="vencido">Vencido 🔴</option>
            <option value="pago">Pago ✓</option>
            <option value="cancelado">Cancelado ✗</option>
        </select>

        <select value="@FiltroNatureza" @onchange='e => { FiltroNatureza = e.Value?.ToString() ?? "todas"; Page = 1; }'
                style="background:var(--card);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:7px 10px;font-size:13px">
            <option value="todas">Natureza: Todas</option>
            <option value="parcela">Parcela (Contrato)</option>
            <option value="comissao">Comissão Parceiro</option>
            <option value="material">Material / Insumo</option>
            <option value="mao-de-obra">Mão-de-Obra</option>
        </select>

        <select value="@FiltroServicoId" @onchange='e => { FiltroServicoId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0; Page = 1; }'
                style="background:var(--card);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:7px 10px;font-size:13px;max-width:240px">
            <option value="0">Serviço: Todos (@Store.Servicos.Count)</option>
            @foreach (var s in Store.Servicos)
            {
                <option value="@s.Id">#@s.Id — @(Store.GetTipoServico(s.TipoServicoId)?.Nome) (@(Store.GetCliente(s.ClienteId)?.Nome))</option>
            }
        </select>
    </div>

    <div class="pager">
        <span>@Filtered.Count item(ns) · Pág. @Page/@TotalPages</span>
        <button disabled="@(Page <= 1)" @onclick="() => Page = 1">⏮</button>
        <button disabled="@(Page <= 1)" @onclick="() => Page--">◀</button>
        <button disabled="@(Page >= TotalPages)" @onclick="() => Page++">▶</button>
        <button disabled="@(Page >= TotalPages)" @onclick="() => Page = TotalPages">⏭</button>
    </div>
</div>

<!-- Resumo de Margem quando um Serviço específico está filtrado -->
@if (FiltroServicoId > 0)
{
    var srvSel = Store.Servicos.FirstOrDefault(x => x.Id == FiltroServicoId);
    if (srvSel is not null)
    {
        var custosPrevistos = Store.Lancamentos.Where(l => l.ServicoId == srvSel.Id && l.Pagar && l.Status != "cancelado").Sum(l => l.ValorCentavos);
        var margemPrevista = srvSel.ValorContrato - custosPrevistos;
        var recPagas = Store.Lancamentos.Where(l => l.ServicoId == srvSel.Id && !l.Pagar && l.Status == "pago").Sum(l => l.ValorCentavos);
        var pagPagas = Store.Lancamentos.Where(l => l.ServicoId == srvSel.Id && l.Pagar && l.Status == "pago").Sum(l => l.ValorCentavos);
        var margemRealizada = recPagas - pagPagas;

        <div style="background:var(--card);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:12px;padding:12px 16px;margin-bottom:14px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:13px">
            <div>
                <strong>Recorte do Serviço #@srvSel.Id:</strong> @(Store.GetTipoServico(srvSel.TipoServicoId)?.Nome) — @(Store.GetCliente(srvSel.ClienteId)?.Nome)
            </div>
            <div style="display:flex;gap:18px;flex-wrap:wrap">
                <span>Valor Contrato: <b>@MockErpStore.FormatMoeda(srvSel.ValorContrato)</b></span>
                <span>Custos Previstos: <b class="down">@MockErpStore.FormatMoeda(custosPrevistos)</b></span>
                <span>Margem Prevista: <b class="up">@MockErpStore.FormatMoeda(margemPrevista)</b></span>
                <span>Margem Realizada: <b>@MockErpStore.FormatMoeda(margemRealizada)</b></span>
            </div>
        </div>
    }
}

<!-- Grid Único Pagar + Receber -->
<div class="grid-card">
    <table class="grid">
        <thead>
            <tr>
                <th>Direção</th>
                <th>Status</th>
                <th>Descrição / Natureza</th>
                <th class="hide-m">Serviço Vinculado</th>
                <th>Beneficiário / Cliente</th>
                <th>Vencimento</th>
                <th class="hide-m">Pago em</th>
                <th class="num">Valor</th>
            </tr>
        </thead>
        <tbody>
            @if (Paged.Count == 0)
            {
                <tr>
                    <td colspan="8" class="muted" style="text-align:center;padding:28px">
                        Nenhum lançamento financeiro encontrado com os filtros selecionados.
                    </td>
                </tr>
            }
            @foreach (var l in Paged)
            {
                <tr class='@(Editing?.Id == l.Id ? "sel" : "")'
                    style='@(l.Status == "cancelado" ? "opacity:.55" : "")'
                    @onclick="() => AbrirEdicao(l)">
                    <td>
                        @if (l.Pagar)
                        {
                            <span class="dir out">▲ Pagar</span>
                        }
                        else
                        {
                            <span class="dir in">▼ Receber</span>
                        }
                    </td>
                    <td>
                        @switch (l.Status)
                        {
                            case "pago":
                                <span class="badge b-ok">pago ✓</span>
                                break;
                            case "vencido":
                                <span class="badge b-err">vencido 🔴</span>
                                break;
                            case "cancelado":
                                <span class="badge b-muted">cancelado ✗</span>
                                break;
                            default:
                                <span class="badge b-warn">pendente</span>
                                break;
                        }
                    </td>
                    <td>
                        <div style="font-weight:600">@l.Descricao</div>
                        <small class="muted">
                            @FormatNatureza(l.Natureza)
                            @if (!string.IsNullOrWhiteSpace(l.MotivoCancelamento))
                            {
                                <span> · Cancelado: @l.MotivoCancelamento</span>
                            }
                        </small>
                    </td>
                    <td class="hide-m">
                        <span class="badge b-muted">#@l.ServicoId · @GetServicoLabel(l.ServicoId)</span>
                    </td>
                    <td>@l.BeneficiarioOuCliente</td>
                    <td class="mono">@l.Vencimento.ToString("dd/MM/yyyy")</td>
                    <td class="mono muted hide-m">@(string.IsNullOrWhiteSpace(l.PagoEm) ? "—" : l.PagoEm)</td>
                    <td class="num mono" style='font-weight:600;color:@(l.Pagar ? "var(--err)" : "var(--ok)")'>
                        @(l.Pagar ? "- " : "+ ")@MockErpStore.FormatMoeda(l.ValorCentavos)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Criar / Editar Lançamento -->
@if (ShowModal && Editing is not null)
{
    var canEdit = Store.HasPerm("financeiro.edit");
    <div class="modal-back" @onclick="FecharModal">
        <div class="modal" style="width:min(620px,96vw);max-height:90vh;overflow-y:auto" @onclick:stopPropagation="true">
            <div style="display:flex;justify-content:space-between;align-items:center">
                <h3>@(IsNew ? "Novo Lançamento Financeiro" : $"Lançamento #{Editing.Id}")</h3>
                <span class='badge @(Editing.Pagar ? "b-err" : "b-ok")'>
                    @(Editing.Pagar ? "▲ Conta a Pagar" : "▼ Conta a Receber")
                </span>
            </div>

            @if (!string.IsNullOrEmpty(ErroModal))
            {
                <div style="background:rgba(192,57,43,.12);color:var(--err);border:1px solid var(--err);border-radius:8px;padding:9px 12px;font-size:12.5px">
                    ⚠ @ErroModal
                </div>
            }

            <div class="fld-row">
                <label class="fld">
                    Serviço Vinculado *
                    <select value="@FormServicoId" disabled="@(!canEdit)" @onchange="OnServicoModalChanged">
                        @foreach (var s in Store.Servicos)
                        {
                            var cli = Store.GetCliente(s.ClienteId);
                            var tp = Store.GetTipoServico(s.TipoServicoId);
                            <option value="@s.Id">#@s.Id — @tp?.Nome (@cli?.Nome)</option>
                        }
                    </select>
                </label>

                <label class="fld">
                    Direção *
                    <select value='@(FormPagar ? "pagar" : "receber")' disabled="@(!canEdit)" @onchange="OnDirecaoModalChanged">
                        <option value="receber">▼ A Receber (Parcela de Cliente)</option>
                        <option value="pagar">▲ A Pagar (Custo / Comissão)</option>
                    </select>
                </label>
            </div>

            <div class="fld-row">
                <label class="fld">
                    Natureza *
                    <select @bind="FormNatureza" disabled="@(!canEdit)">
                        <option value="parcela">Parcela de Contrato</option>
                        <option value="comissao">Comissão de Parceiro</option>
                        <option value="material">Material / Fornecedor</option>
                        <option value="mao-de-obra">Mão-de-Obra / Diária</option>
                    </select>
                </label>

                <label class="fld">
                    Status Atual
                    <select @bind="FormStatus" disabled='@(!canEdit || FormStatus == "cancelado")'>
                        <option value="pendente">Pendente</option>
                        <option value="vencido">Vencido 🔴</option>
                        <option value="pago">Pago ✓</option>
                        @if (FormStatus == "cancelado")
                        {
                            <option value="cancelado">Cancelado ✗</option>
                        }
                    </select>
                </label>
            </div>

            @if (FormPagar)
            {
                <label class="fld">
                    Vincular Membro da Equipe / Parceiro (Opcional)
                    <select value="@(FormMembroEquipeId ?? 0)" disabled="@(!canEdit)" @onchange="OnMembroModalChanged">
                        <option value="0">— Fornecedor externo / digitar manualmente —</option>
                        @foreach (var m in Store.Equipe)
                        {
                            <option value="@m.Id">@m.Nome (@m.Perfil — @m.Funcao)</option>
                        }
                    </select>
                </label>
            }

            <label class="fld">
                Descrição do Lançamento *
                <input @bind="FormDescricao" disabled="@(!canEdit)" placeholder="Ex.: Parcela 2/3 — Cozinha Planejada" />
            </label>

            <div class="fld-row">
                <label class="fld">
                    @(FormPagar ? "Beneficiário / Favorecido *" : "Cliente Pagador *")
                    <input @bind="FormBeneficiario" disabled="@(!canEdit)" placeholder="Nome do cliente ou favorecido" />
                </label>

                <label class="fld">
                    Valor (R$) *
                    <input type="number" step="0.01" min="0" @bind="FormValorReais" disabled="@(!canEdit)" />
                </label>
            </div>

            <div class="fld-row">
                <label class="fld">
                    Data de Vencimento *
                    <input type="date"
                           value="@FormVencimento.ToString("yyyy-MM-dd")"
                           disabled="@(!canEdit)"
                           @onchange="e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) FormVencimento = d; }" />
                </label>

                <label class="fld">
                    Pago em (Data da Baixa)
                    <input @bind="FormPagoEm" disabled="@(!canEdit)" placeholder="dd/mm/aaaa ou —" />
                </label>
            </div>

            @if (!IsNew && Editing.Status != "cancelado" && canEdit)
            {
                <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;background:var(--bg);padding:10px 12px;border-radius:10px;border:1px solid var(--line);flex-wrap:wrap">
                    @if (FormStatus != "pago")
                    {
                        <button type="button" class="btn primary" @onclick="DarBaixaHoje">
                            ✓ Dar Baixa (Marcar Pago hoje — 30/10/2026)
                        </button>
                    }
                    else
                    {
                        <span class="badge b-ok">✓ Baixado em @FormPagoEm</span>
                    }

                    <button type="button" class="btn danger" @onclick="() => ShowCancelBox = !ShowCancelBox">
                        ✗ Cancelar Lançamento
                    </button>
                </div>

                @if (ShowCancelBox)
                {
                    <div style="background:rgba(192,57,43,.07);border:1px dashed var(--err);border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:8px">
                        <strong style="font-size:12.5px;color:var(--err)">Cancelamento Auditável (Sem exclusão de dados)</strong>
                        <label class="fld">
                            Motivo do Cancelamento (Obrigatório) *
                            <input @bind="FormMotivoCancelamento" placeholder="Informe a justificativa para cancelar esta parcela/lançamento..." />
                        </label>
                        <div class="actions end">
                            <button type="button" class="btn" @onclick="() => ShowCancelBox = false">Voltar</button>
                            <button type="button" class="btn danger" @onclick="ConfirmarCancelamento">Confirmar Cancelamento</button>
                        </div>
                    </div>
                }
            }

            @if (Editing.Status == "cancelado")
            {
                <div style="background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:12.5px">
                    <strong>Lançamento Cancelado:</strong> @Editing.MotivoCancelamento
                </div>
            }

            <div class="actions end" style="margin-top:6px">
                <button type="button" class="btn" @onclick="FecharModal">Fechar</button>
                @if (canEdit && Editing.Status != "cancelado")
                {
                    <button type="button" class="btn primary" @onclick="SalvarModal">Salvar</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private string Busca = "";
    private string FiltroDirecao = "todos";
    private string FiltroStatus = "todos";
    private string FiltroNatureza = "todas";
    private int FiltroServicoId = 0;
    private int Page = 1;
    private const int PageSize = 8;

    private bool ShowModal;
    private bool IsNew;
    private bool ShowCancelBox;
    private string ErroModal = "";
    private LancamentoFinanceiro? Editing;

    // Form fields
    private int FormServicoId = 1;
    private bool FormPagar;
    private string FormNatureza = "parcela";
    private string FormStatus = "pendente";
    private int? FormMembroEquipeId;
    private string FormDescricao = "";
    private string FormBeneficiario = "";
    private decimal FormValorReais;
    private DateOnly FormVencimento = new(2026, 11, 10);
    private string FormPagoEm = "—";
    private string FormMotivoCancelamento = "";

    private long TotalReceberAtivos => Store.Lancamentos.Where(l => !l.Pagar && l.Status != "cancelado").Sum(l => l.ValorCentavos);
    private long TotalRecebidoPago => Store.Lancamentos.Where(l => !l.Pagar && l.Status == "pago").Sum(l => l.ValorCentavos);
    private long TotalReceberAberto => Store.Lancamentos.Where(l => !l.Pagar && l.Status is "pendente" or "vencido").Sum(l => l.ValorCentavos);

    private long TotalPagarAtivos => Store.Lancamentos.Where(l => l.Pagar && l.Status != "cancelado").Sum(l => l.ValorCentavos);
    private long TotalPagoEfetivo => Store.Lancamentos.Where(l => l.Pagar && l.Status == "pago").Sum(l => l.ValorCentavos);
    private long TotalPagarAberto => Store.Lancamentos.Where(l => l.Pagar && l.Status is "pendente" or "vencido").Sum(l => l.ValorCentavos);

    private long SaldoPrevisto => TotalReceberAtivos - TotalPagarAtivos;
    private long SaldoRealizado => TotalRecebidoPago - TotalPagoEfetivo;

    private long TotalVencidos => Store.Lancamentos.Where(l => l.Status == "vencido").Sum(l => l.ValorCentavos);
    private int QtdVencidos => Store.Lancamentos.Count(l => l.Status == "vencido");

    private long TotalComissoesPendentes => Store.Lancamentos.Where(l => l.Pagar && l.Natureza == "comissao" && l.Status is "pendente" or "vencido").Sum(l => l.ValorCentavos);
    private int QtdComissoesPendentes => Store.Lancamentos.Count(l => l.Pagar && l.Natureza == "comissao" && l.Status is "pendente" or "vencido");

    private List<LancamentoFinanceiro> Filtered => Store.Lancamentos
        .Where(l =>
        {
            if (FiltroDirecao == "receber" && l.Pagar) return false;
            if (FiltroDirecao == "pagar" && !l.Pagar) return false;
            if (FiltroStatus != "todos" && l.Status != FiltroStatus) return false;
            if (FiltroNatureza != "todas" && l.Natureza != FiltroNatureza) return false;
            if (FiltroServicoId > 0 && l.ServicoId != FiltroServicoId) return false;
            if (!string.IsNullOrWhiteSpace(Busca))
            {
                var q = Busca.Trim().ToLowerInvariant();
                var srvLbl = GetServicoLabel(l.ServicoId).ToLowerInvariant();
                if (!l.Descricao.ToLowerInvariant().Contains(q) &&
                    !l.BeneficiarioOuCliente.ToLowerInvariant().Contains(q) &&
                    !srvLbl.Contains(q))
                    return false;
            }
            return true;
        })
        .OrderBy(l => l.Vencimento)
        .ThenBy(l => l.Id)
        .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)PageSize));
    private List<LancamentoFinanceiro> Paged => Filtered.Skip((Page - 1) * PageSize).Take(PageSize).ToList();

    private void OnBuscaChanged(ChangeEventArgs e)
    {
        Busca = e.Value?.ToString() ?? "";
        Page = 1;
    }

    private string GetServicoLabel(int servicoId)
    {
        var s = Store.Servicos.FirstOrDefault(x => x.Id == servicoId);
        if (s is null) return "—";
        var tp = Store.GetTipoServico(s.TipoServicoId)?.Nome ?? "Serviço";
        var cli = Store.GetCliente(s.ClienteId)?.Nome ?? "Cliente";
        return $"{tp} — {cli}";
    }

    private static string FormatNatureza(string nat) => nat switch
    {
        "parcela" => "Parcela de Contrato",
        "comissao" => "Comissão de Parceiro",
        "material" => "Material / Insumos",
        "mao-de-obra" => "Mão-de-Obra",
        _ => nat
    };

    private void AbrirNovo()
    {
        var srv = Store.Servicos.FirstOrDefault();
        var cli = srv is not null ? Store.GetCliente(srv.ClienteId) : null;
        IsNew = true;
        ShowCancelBox = false;
        ErroModal = "";
        Editing = new LancamentoFinanceiro();
        FormServicoId = srv?.Id ?? 1;
        FormPagar = false;
        FormNatureza = "parcela";
        FormStatus = "pendente";
        FormMembroEquipeId = null;
        FormDescricao = "";
        FormBeneficiario = cli?.Nome ?? "";
        FormValorReais = 0m;
        FormVencimento = new DateOnly(2026, 11, 15);
        FormPagoEm = "—";
        FormMotivoCancelamento = "";
        ShowModal = true;
    }

    private void AbrirEdicao(LancamentoFinanceiro l)
    {
        IsNew = false;
        ShowCancelBox = false;
        ErroModal = "";
        Editing = l;
        FormServicoId = l.ServicoId;
        FormPagar = l.Pagar;
        FormNatureza = l.Natureza;
        FormStatus = l.Status;
        FormMembroEquipeId = l.MembroEquipeId;
        FormDescricao = l.Descricao;
        FormBeneficiario = l.BeneficiarioOuCliente;
        FormValorReais = l.ValorCentavos / 100.0m;
        FormVencimento = l.Vencimento;
        FormPagoEm = l.PagoEm;
        FormMotivoCancelamento = l.MotivoCancelamento;
        ShowModal = true;
    }

    private void OnServicoModalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sid))
        {
            FormServicoId = sid;
            if (!FormPagar)
            {
                var srv = Store.Servicos.FirstOrDefault(x => x.Id == sid);
                var cli = srv is not null ? Store.GetCliente(srv.ClienteId) : null;
                if (cli is not null)
                    FormBeneficiario = cli.Nome;
            }
        }
    }

    private void OnDirecaoModalChanged(ChangeEventArgs e)
    {
        FormPagar = (e.Value?.ToString() == "pagar");
        if (!FormPagar)
        {
            FormNatureza = "parcela";
            var srv = Store.Servicos.FirstOrDefault(x => x.Id == FormServicoId);
            var cli = srv is not null ? Store.GetCliente(srv.ClienteId) : null;
            if (cli is not null)
                FormBeneficiario = cli.Nome;
        }
        else if (FormNatureza == "parcela")
        {
            FormNatureza = "material";
        }
    }

    private void OnMembroModalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var mid) && mid > 0)
        {
            FormMembroEquipeId = mid;
            var m = Store.GetMembroEquipe(mid);
            if (m is not null)
            {
                FormBeneficiario = m.Nome;
                if (m.Perfil == "Parceiro")
                    FormNatureza = "comissao";
                else
                    FormNatureza = "mao-de-obra";
            }
        }
        else
        {
            FormMembroEquipeId = null;
        }
    }

    private void DarBaixaHoje()
    {
        FormStatus = "pago";
        FormPagoEm = "30/10/2026";
        SalvarModal();
    }

    private void ConfirmarCancelamento()
    {
        if (Editing is null) return;
        if (string.IsNullOrWhiteSpace(FormMotivoCancelamento))
        {
            ErroModal = "Para cancelar um lançamento financeiro, informe obrigatoriamente o motivo.";
            return;
        }

        Editing.Status = "cancelado";
        Editing.MotivoCancelamento = FormMotivoCancelamento.Trim();
        var cli = Store.GetCliente(Editing.ClienteId);
        cli?.Timeline.Add(new("30/10/2026 11:30", Store.CurrentRole, $"Lançamento #{Editing.Id} ({Editing.Descricao}) cancelado — Motivo: {Editing.MotivoCancelamento}"));
        Store.NotifyStateChanged();
        ShowModal = false;
    }

    private void SalvarModal()
    {
        if (Editing is null) return;
        if (string.IsNullOrWhiteSpace(FormDescricao))
        {
            ErroModal = "Informe a descrição do lançamento.";
            return;
        }
        if (string.IsNullOrWhiteSpace(FormBeneficiario))
        {
            ErroModal = "Informe o cliente ou beneficiário.";
            return;
        }
        if (FormValorReais <= 0)
        {
            ErroModal = "O valor deve ser maior que zero.";
            return;
        }

        var srv = Store.Servicos.FirstOrDefault(x => x.Id == FormServicoId);
        Editing.ServicoId = FormServicoId;
        Editing.ClienteId = srv?.ClienteId ?? 1;
        Editing.Pagar = FormPagar;
        Editing.Natureza = FormNatureza;
        Editing.Status = FormStatus;
        Editing.MembroEquipeId = FormPagar ? FormMembroEquipeId : null;
        Editing.Descricao = FormDescricao.Trim();
        Editing.BeneficiarioOuCliente = FormBeneficiario.Trim();
        Editing.ValorCentavos = (long)Math.Round(FormValorReais * 100m);
        Editing.Vencimento = FormVencimento;
        Editing.PagoEm = FormStatus == "pago"
            ? (string.IsNullOrWhiteSpace(FormPagoEm) || FormPagoEm == "—" ? "30/10/2026" : FormPagoEm.Trim())
            : "—";

        if (IsNew)
        {
            Editing.Id = Store.Lancamentos.Count > 0 ? Store.Lancamentos.Max(x => x.Id) + 1 : 1;
            Store.Lancamentos.Add(Editing);
        }

        Store.NotifyStateChanged();
        ShowModal = false;
    }

    private void FecharModal()
    {
        ShowModal = false;
        ShowCancelBox = false;
        ErroModal = "";
    }
}
