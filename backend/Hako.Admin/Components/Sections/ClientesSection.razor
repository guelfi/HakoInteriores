    void SalvarOrcamento(NegociacaoItem neg)
    {
        if (ModalCli is null) return;
        foreach (var ant in neg.Orcamentos.Where(o => o.Status == "enviado"))
            ant.Status = "substituido";

        var novo = new OrcamentoItem
        {
            Id = Store.Negociacoes.SelectMany(n => n.Orcamentos).Select(o => o.Id).DefaultIfEmpty(0).Max() + 1,
            NegociacaoId = neg.Id,
            Versao = neg.Orcamentos.Count + 1,
            Valor = (long)(NovoOrcValorReais * 100),
            PrazoExecucaoDias = NovoOrcPrazoDias,
            CondicoesPagamento = NovoOrcCondicoes,
            EscopoResumo = NovoOrcEscopo,
            ArquivoPdf = NovoOrcPdf,
            Status = "enviado",
            EnviadoEm = "30/10/2026"
        };
        neg.Orcamentos.Add(novo);
        neg.ValorEstimado = novo.Valor;
        ShowFormOrcamento = false;
        ModalCli.Timeline.Add(new("30/10/2026 10:30", Store.CurrentRole, $"Orçamento v{novo.Versao} enviado ({MockErpStore.FormatMoeda(novo.Valor)}) na Negociação #{neg.Id}"));
        FeedbackErro = false;
        FeedbackMsg = $"Orçamento v{novo.Versao} registrado e enviado!";
        Store.NotifyStateChanged();
    }

