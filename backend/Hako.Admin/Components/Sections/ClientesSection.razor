    static string GetStatusDot(string status) => status switch
    {
        "ativo" => "on",
        "suspenso" => "s-warn",
        "cancelado" => "s-err",
        _ => "off"
    };

    static string GetStatusBadge(string status) => status switch
    {
        "ativo" => "b-ok",
        "suspenso" => "b-warn",
        "cancelado" => "b-err",
        _ => "b-muted"
    };

    static string GetOrcStatusBadge(string status) => status switch
    {
        "aceito" => "b-ok",
        "enviado" => "b-info",
        "recusado" => "b-err",
        _ => "b-muted"
    };

    static string FormatOrigem(string o) => o switch
    {
        "lp" => "LP",
        "instagram" => "Instagram",
        "indicacao" => "Indicação",
        "parceiro" => "Parceiro",
        _ => "Outro"
    };
