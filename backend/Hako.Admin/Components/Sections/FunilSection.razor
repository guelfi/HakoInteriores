<p class="hint">Arraste ou toque num card e depois na coluna de destino.</p>

<div class="board-wrap">
    <div class="board">
        @foreach (var col in Colunas)
        {
            <div class="bcol @(DragOver == col || (Sel is not null && Sel.Value.Col != col) ? "drop" : "")"
                 @onclick="() => ToqueCol(col)"
                 @ondragover="() => DragOver = col" @ondragover:preventDefault
                 @ondrop="() => Drop(col)" @ondragleave="() => DragOver = null">
                <header>@col.Nome <span class="count">@col.Leads.Count</span></header>
                @foreach (var l in col.Leads)
                {
                    <div class="kcard @(col.Nome is "Ganho" ? "h-ok" : col.Nome is "Perdido" ? "h-err" : "") @(Sel?.Lead == l ? "picked" : "")"
                         draggable="true" @ondragstart="() => Drag = (col, l)"
                         @onclick="() => ToqueCard(col, l)" @onclick:stopPropagation>
                        <b>@l.Nome</b>
                        <small>@l.Interesse</small>
                        <small class="mono muted">@l.Tel</small>
                    </div>
                }
            </div>
        }
    </div>
    @if (!IgnorarHint)
    {
        <div class="rotate-hint">
            <span class="rot-ico">↻</span>
            <p>Gire o dispositivo para visualizar o board</p>
            <button type="button" class="btn" @onclick="() => IgnorarHint = true">Continuar assim mesmo</button>
        </div>
    }
</div>

@code {
    record Lead(string Nome, string Interesse, string Tel);
    class Col { public required string Nome; public List<Lead> Leads = []; }

    (Col Col, Lead Lead)? Drag;
    (Col Col, Lead Lead)? Sel;
    Col? DragOver;
    bool IgnorarHint;

    void ToqueCard(Col col, Lead lead) => Sel = Sel?.Lead == lead ? null : (col, lead);

    void ToqueCol(Col destino)
    {
        if (Sel is { } s && s.Col != destino)
        {
            s.Col.Leads.Remove(s.Lead);
            destino.Leads.Add(s.Lead);
        }
        Sel = null;
    }

    void Drop(Col destino)
    {
        if (Drag is { } d && d.Col != destino)
        {
            d.Col.Leads.Remove(d.Lead);
            destino.Leads.Add(d.Lead);
        }
        Drag = null;
        DragOver = null;
    }

    List<Col> Colunas =
    [
        new() { Nome = "Novo", Leads = [new("Fernanda Lira", "Cozinha", "(11) 96543-3300"), new("Juliana Matos", "Banheiro", "(11) 94321-5500"), new("Patrícia Gomes", "Living", "(11) 98865-1111")] },
        new() { Nome = "Contato", Leads = [new("André Sales", "Dormitório", "(11) 91098-8800"), new("Loja Centro", "Balcão comercial", "(11) 3030-4040")] },
        new() { Nome = "Visita/Medição", Leads = [new("Tiago Braga", "Cozinha + lavanderia", "(11) 97788-9900")] },
        new() { Nome = "Orçamento", Leads = [new("Condomínio Vista", "Hall de entrada", "(11) 3444-5555"), new("Renata Piva", "Home office", "(11) 96677-8888")] },
        new() { Nome = "Negociação", Leads = [new("Marcos Tuler", "Reforma completa", "(11) 95566-7777")] },
        new() { Nome = "Ganho", Leads = [new("Camila Ferraz", "Home office", "(11) 90087-9900")] },
        new() { Nome = "Perdido", Leads = [new("Otávio Reis", "Preço", "(11) 94455-6666")] },
    ];
}
